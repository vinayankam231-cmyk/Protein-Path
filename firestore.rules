rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation for UserProfile
    function isValidUserProfile(data, userId) {
      return data.userId == userId &&
             data.email is string &&
             data.email.size() > 0 && data.email.size() <= 256;
    }

    // Validation for UserOrder
    function isValidUserOrder(data, userId) {
      return data.userId == userId &&
             data.orderId is string &&
             data.orderId.size() > 0 && data.orderId.size() <= 128 &&
             data.restaurantName is string &&
             data.totalAmount is number &&
             data.totalAmount >= 0 &&
             data.status is string;
    }

    // Validation for FavoriteDish
    function isValidFavorite(data, userId) {
      return data.userId == userId &&
             data.foodId is string &&
             data.foodId.size() > 0 && data.foodId.size() <= 128;
    }

    // User profile document
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(request.resource.data, userId);
      allow update: if isOwner(userId) && isValidUserProfile(request.resource.data, userId);
      allow delete: if false;

      // User orders subcollection
      match /orders/{orderId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(orderId) && isValidUserOrder(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidUserOrder(request.resource.data, userId);
        allow delete: if false;
      }

      // User favorites subcollection
      match /favorites/{foodId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(foodId) && isValidFavorite(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidFavorite(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }
    }

    // Connection testing doc
    match /test/connection {
      allow read: if true;
    }
  }
}
